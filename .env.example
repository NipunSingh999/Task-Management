# TaskFlow Environment Configuration Example
SECRET_KEY=django-insecure-taskflow-dev-secret-key-replace-in-production-1234567890
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database Configuration
# For PostgreSQL: postgresql://<user>:<password>@<host>:<port>/<dbname>
# Leave blank or omit to fallback to local SQLite for rapid development
DATABASE_URL=postgresql://taskflow_user:taskflow_password@localhost:5432/taskflow_db

# CORS Configuration (comma-separated origins)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# JWT Configuration
ACCESS_TOKEN_LIFETIME_MINUTES=60
REFRESH_TOKEN_LIFETIME_DAYS=7
